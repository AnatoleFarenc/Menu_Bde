# Copie ce fichier en .env et remplis les valeurs

# Créés sur https://profile.intra.42.fr/oauth/applications/new
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
# Doit correspondre EXACTEMENT à la redirect URI déclarée sur l'intra
FORTYTWO_CALLBACK_URL=http://localhost:3000/auth/42/callback

# Clé secrète pour signer les sessions (mets une chaîne aléatoire longue)
SESSION_SECRET=change-moi-en-production

# Logins intra (séparés par des virgules) qui ont les droits admin
ADMIN_LOGINS=anfarenc

PORT=3000
