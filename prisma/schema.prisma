generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Storefront
// ---------------------------------------------------------------------------

model Category {
  id        String    @id
  name      String
  icon      String    @default("📦")
  isVisible Boolean   @default(true)
  products  Product[]
}

model Product {
  id             String   @id @default(cuid())
  name           String
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  price          Float
  extraMenuPrice Float    @default(0)
  costPrice      Float?
  stock          Int?
  description    String?  @db.Text
  badge          String   @default("")
  available      Boolean  @default(true)
  icon           String   @default("🥪")
  createdAt      DateTime @default(now())

  menuGroups MenuGroupProduct[]

  @@index([categoryId])
}

model Menu {
  id          String   @id @default(cuid())
  name        String
  price       Float
  description String?  @db.Text
  badge       String   @default("")
  available   Boolean  @default(true)
  icon        String   @default("🍱")
  createdAt   DateTime @default(now())
  groups      MenuGroup[]
}

// A meal-deal choice group (e.g. "Main", "Drink").
model MenuGroup {
  id       String  @id @default(cuid())
  menuId   String
  menu     Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name     String
  position Int     @default(0)

  products MenuGroupProduct[]

  @@index([menuId])
}

// Products offered in a choice group (many-to-many Menu group <-> Product).
model MenuGroupProduct {
  menuGroupId String
  menuGroup   MenuGroup @relation(fields: [menuGroupId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([menuGroupId, productId])
}

// Saved catalog snapshot (products + meal deals + categories), replayable as-is.
// Stored as JSON: these are frozen snapshots, not live data to query
// relationally.
model Template {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  products    Json
  menus       Json
  categories  Json
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id              String    @id @default(cuid())
  orderNumber     String    @unique
  status          String    @default("pending") // pending | preparing | ready | completed | cancelled
  isPaid          Boolean   @default(false)
  isFree          Boolean   @default(false)
  userId          String
  userLogin       String
  userDisplayName String
  pickupTime      String
  note            String    @default("") @db.Text
  totalPrice      Float
  createdAt       DateTime  @default(now())

  reviewRating    Int?
  reviewComment   String?   @db.Text
  reviewCreatedAt DateTime?

  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// An order line. Name/price/cost are duplicated here at order time
// (snapshot), deliberately: history must stay accurate even if the
// original product or meal deal is later changed or deleted.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String  // 'product' | 'menu'
  refId     String  // id of the product/meal deal at order time
  name      String
  category  String? // snapshot, used only for the displayed icon
  price     Float
  costPrice Float?
  quantity  Int

  choices OrderItemChoice[]

  @@index([orderId])
}

// For a "meal deal" line: which product was chosen in each group.
// Also a snapshot (name + cost at order time).
model OrderItemChoice {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  groupName   String
  productId   String
  productName String
  costPrice   Float?

  @@index([orderItemId])
}
