generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Storefront
// ---------------------------------------------------------------------------

model Category {
  id        String    @id
  name      String
  icon      String    @default("📦")
  isVisible Boolean   @default(true)
  products  Product[]
}

// A dated sale (a "piscine", a midterm, a party...). An event can hold
// several storefronts (e.g. "Petit-déjeuner" and "Déjeuner" for the same
// event) -- each with its own catalog, orders and resource list. Exactly one
// storefront across the whole app is live at a time; that storefront's
// parent event is implicitly "the current event".
model Event {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  status      String    @default("upcoming") // upcoming | ongoing | completed
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  storefronts Storefront[]

  @@index([status])
}

// One catalog + order stream within an event. Switching which storefront is
// active never destroys the others: past storefronts (and past events) stay
// intact and queryable, just no longer shown to students.
model Storefront {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  products     Product[]
  menus        Menu[]
  orders       Order[]
  shoppingList ShoppingListItem[]

  @@index([eventId])
  @@index([isActive])
}

// One line of a storefront's shopping/resource list: what was bought to run
// it, so another team can rebuild the same storefront later. Every field but
// name is optional -- the info isn't always known or tracked.
model ShoppingListItem {
  id               String     @id @default(cuid())
  storefrontId     String
  storefront       Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  name             String
  quantity         Float?
  unit             String?
  forDays          Int?
  forPeople        Int?
  unitCost         Float?
  totalCost        Float?
  purchaseLocation String?
  note             String?    @db.Text
  createdAt        DateTime   @default(now())

  products ShoppingListItemProduct[]

  @@index([storefrontId])
}

// A shopping list line can be destined for several catalog products (e.g.
// "20 baguettes" feeds several different sandwiches).
model ShoppingListItemProduct {
  shoppingListItemId String
  shoppingListItem   ShoppingListItem @relation(fields: [shoppingListItemId], references: [id], onDelete: Cascade)
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([shoppingListItemId, productId])
}

model Product {
  id             String     @id @default(cuid())
  storefrontId   String
  storefront     Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  name           String
  categoryId     String
  category       Category   @relation(fields: [categoryId], references: [id])
  price          Float
  extraMenuPrice Float      @default(0)
  costPrice      Float?
  stock          Int?
  description    String?    @db.Text
  badge          String     @default("")
  available      Boolean    @default(true)
  icon           String     @default("🥪")
  createdAt      DateTime   @default(now())

  menuGroups        MenuGroupProduct[]
  shoppingListLinks ShoppingListItemProduct[]

  @@index([categoryId])
  @@index([storefrontId])
}

model Menu {
  id           String     @id @default(cuid())
  storefrontId String
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  name         String
  price        Float
  description  String?    @db.Text
  badge        String     @default("")
  available    Boolean    @default(true)
  icon         String     @default("🍱")
  createdAt    DateTime   @default(now())
  groups       MenuGroup[]

  @@index([storefrontId])
}

// A meal-deal choice group (e.g. "Main", "Drink").
model MenuGroup {
  id       String  @id @default(cuid())
  menuId   String
  menu     Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name     String
  position Int     @default(0)

  products MenuGroupProduct[]

  @@index([menuId])
}

// Products offered in a choice group (many-to-many Menu group <-> Product).
model MenuGroupProduct {
  menuGroupId String
  menuGroup   MenuGroup @relation(fields: [menuGroupId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([menuGroupId, productId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id              String     @id @default(cuid())
  storefrontId    String
  storefront      Storefront @relation(fields: [storefrontId], references: [id])
  orderNumber     String     @unique
  status          String     @default("pending") // pending | preparing | ready | completed | cancelled
  isPaid          Boolean    @default(false)
  isFree          Boolean    @default(false)
  userId          String
  userLogin       String
  userDisplayName String
  pickupTime      String
  note            String     @default("") @db.Text
  totalPrice      Float
  createdAt       DateTime   @default(now())

  reviewRating    Int?
  reviewComment   String?    @db.Text
  reviewCreatedAt DateTime?

  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([storefrontId])
}

// An order line. Name/price/cost are duplicated here at order time
// (snapshot), deliberately: history must stay accurate even if the
// original product or meal deal is later changed or deleted.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String  // 'product' | 'menu'
  refId     String  // id of the product/meal deal at order time
  name      String
  category  String? // snapshot, used only for the displayed icon
  price     Float
  costPrice Float?
  quantity  Int

  choices OrderItemChoice[]

  @@index([orderId])
}

// For a "meal deal" line: which product was chosen in each group.
// Also a snapshot (name + cost at order time).
model OrderItemChoice {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  groupName   String
  productId   String
  productName String
  costPrice   Float?

  @@index([orderItemId])
}
