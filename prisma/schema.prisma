generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Vitrine
// ---------------------------------------------------------------------------

model Category {
  id        String    @id
  name      String
  icon      String    @default("📦")
  isVisible Boolean   @default(true)
  products  Product[]
}

model Product {
  id             String   @id @default(cuid())
  name           String
  categoryId     String
  category       Category @relation(fields: [categoryId], references: [id])
  price          Float
  extraMenuPrice Float    @default(0)
  costPrice      Float?
  stock          Int?
  description    String?  @db.Text
  badge          String   @default("")
  available      Boolean  @default(true)
  icon           String   @default("🥪")
  createdAt      DateTime @default(now())

  menuGroups MenuGroupProduct[]

  @@index([categoryId])
}

model Menu {
  id          String   @id @default(cuid())
  name        String
  price       Float
  description String?  @db.Text
  badge       String   @default("")
  available   Boolean  @default(true)
  icon        String   @default("🍱")
  createdAt   DateTime @default(now())
  groups      MenuGroup[]
}

// Un groupe de choix d'une formule (ex: "Plat", "Boisson").
model MenuGroup {
  id       String  @id @default(cuid())
  menuId   String
  menu     Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name     String
  position Int     @default(0)

  products MenuGroupProduct[]

  @@index([menuId])
}

// Produits proposés dans un groupe de choix (many-to-many Menu group <-> Product).
model MenuGroupProduct {
  menuGroupId String
  menuGroup   MenuGroup @relation(fields: [menuGroupId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([menuGroupId, productId])
}

// Catalogue sauvegardé (produits + menus + catégories), rejouable tel quel.
// Stocké en JSON : ce sont des instantanés figés, pas des données vivantes à
// interroger relationnellement.
model Template {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  products    Json
  menus       Json
  categories  Json
}

// ---------------------------------------------------------------------------
// Commandes
// ---------------------------------------------------------------------------

model Order {
  id              String    @id @default(cuid())
  orderNumber     String    @unique
  status          String    @default("pending") // pending | preparing | ready | completed | cancelled
  isPaid          Boolean   @default(false)
  isFree          Boolean   @default(false)
  userId          String
  userLogin       String
  userDisplayName String
  pickupTime      String
  note            String    @default("") @db.Text
  totalPrice      Float
  createdAt       DateTime  @default(now())

  reviewRating    Int?
  reviewComment   String?   @db.Text
  reviewCreatedAt DateTime?

  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// Une ligne de commande. Le nom/prix/coût sont dupliqués ici au moment de la
// commande (snapshot), volontairement : l'historique doit rester exact même
// si le produit ou la formule d'origine est ensuite modifié ou supprimé.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String  // 'product' | 'menu'
  refId     String  // id du produit/de la formule au moment de la commande
  name      String
  category  String? // snapshot, sert uniquement à l'icône affichée
  price     Float
  costPrice Float?
  quantity  Int

  choices OrderItemChoice[]

  @@index([orderId])
}

// Pour une ligne "formule" : quel produit a été choisi dans chaque groupe.
// Snapshot également (nom + coût au moment de la commande).
model OrderItemChoice {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  groupName   String
  productId   String
  productName String
  costPrice   Float?

  @@index([orderItemId])
}
