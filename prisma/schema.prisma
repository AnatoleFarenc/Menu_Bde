generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Storefront
// ---------------------------------------------------------------------------

// A BDE member's role, assigned by a Board member from the /gestion team
// screen. Keyed by 42 login (lowercase) and looked up at login time. A login
// with no row here is a plain Member (no admin rights) unless it's still
// covered by the legacy ADMIN_LOGINS/MANAGER_LOGINS env fallback -- see
// resolveRole() in auth42.js.
model TeamMember {
  login     String   @id
  role      String   // 'board' | 'admin' | 'staff'
  addedBy   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id
  name      String
  icon      String    @default("📦")
  isVisible Boolean   @default(true)
  products  Product[]
}

// A dated sale (a "piscine", a midterm, a party...). An event can hold
// several storefronts (e.g. "Petit-déjeuner" and "Déjeuner" for the same
// event) -- each with its own catalog, orders and resource list. Exactly one
// storefront across the whole app is live at a time; that storefront's
// parent event is implicitly "the current event".
model Event {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  status      String    @default("upcoming") // upcoming | ongoing | completed
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  storefronts Storefront[]

  @@index([status])
}

// One catalog + order stream within an event. Switching which storefront is
// active never destroys the others: past storefronts (and past events) stay
// intact and queryable, just no longer shown to students.
model Storefront {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  products      Product[]
  menus         Menu[]
  orders        Order[]
  shoppingList  ShoppingListItem[]
  shoppingTrips ShoppingTrip[]

  @@index([eventId])
  @@index([isActive])
}

// One shopping trip for a storefront: items added while it's open belong to
// it; "closing" it (Courses tab) freezes it as one entry in the shopping-
// list history and the next item added lazily opens a new one. Exactly one
// open (closedAt: null) trip exists per storefront at a time -- see
// getOrCreateOpenTrip in db.js.
model ShoppingTrip {
  id           String     @id @default(cuid())
  storefrontId String
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  closedAt     DateTime?
  createdAt    DateTime   @default(now())

  items ShoppingListItem[]

  @@index([storefrontId])
}

// One line of a shopping trip: what was bought to run the storefront, so
// another team can rebuild it later. Every field but name is optional --
// the info isn't always known or tracked.
model ShoppingListItem {
  id               String       @id @default(cuid())
  storefrontId     String
  storefront       Storefront   @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  tripId           String
  trip             ShoppingTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name             String
  quantity         Float?
  unit             String?
  forDays          Int?
  forPeople        Int?
  unitCost         Float?
  totalCost        Float?
  purchaseLocation String?
  note             String?      @db.Text
  bought           Boolean      @default(false)
  createdAt        DateTime     @default(now())

  products   ShoppingListItemProduct[]
  menus      ShoppingListItemMenu[]
  stockItems ShoppingListItemStockItem[]

  @@index([storefrontId])
  @@index([tripId])
}

// A shopping list line can be destined for several catalog products (e.g.
// "20 baguettes" feeds several different sandwiches).
model ShoppingListItemProduct {
  shoppingListItemId String
  shoppingListItem   ShoppingListItem @relation(fields: [shoppingListItemId], references: [id], onDelete: Cascade)
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([shoppingListItemId, productId])
}

// A shopping list line can also be destined for a meal deal directly (e.g.
// "20 baguettes" bought specifically to restock the "Formule Petit-déj"),
// separate from ShoppingListItemProduct since a Menu has no stock of its
// own to update -- this link is informational only (see closeShoppingTrip
// in db.js, which only ever restocks through the product-link, never this
// one: there's no quantified recipe saying how much of the article goes
// into the meal deal's own components).
model ShoppingListItemMenu {
  shoppingListItemId String
  shoppingListItem   ShoppingListItem @relation(fields: [shoppingListItemId], references: [id], onDelete: Cascade)
  menuId             String
  menu               Menu             @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@id([shoppingListItemId, menuId])
}

// One physically shared stock count, matched by name across every
// storefront and event (roadmap: "les vitrines doivent avoir le même
// stock et être connectées entre elles") -- selling a "Café" in one
// storefront also decrements it everywhere else "Café" is sold. Price,
// description, badge, icon and manual availability all stay per-Product
// (per-storefront), only the stock count itself is shared. See
// getOrCreateInventoryItem in db.js for the name-matching lookup.
//
// This tracks FINISHED/SELLABLE stock (how many ready "Sandwich
// Jambon-Beurre" there are to sell right now) -- it drives storefront
// availability, not shopping. What to actually go buy is StockItem below:
// a sandwich itself can't be purchased at a store, only its ingredients
// can, which is exactly the distinction StockItem/ProductIngredient exist
// to capture.
model InventoryItem {
  id                String   @id @default(cuid())
  name              String
  normalizedName    String   @unique
  stock             Int?
  // Below this stock count the Stock tab flags every linked product as
  // "low" -- shared, since it's the same physical stock.
  lowStockThreshold Int      @default(5)
  createdAt         DateTime @default(now())

  products Product[]
}

// A raw ingredient/supply the BDE actually buys (ham, bread, butter...) --
// managed by hand, global like InventoryItem (the same physical pantry
// serves every event), and the sole basis for the Stock tab's automatic
// shopping-list generation: a StockItem at or below its threshold gets
// suggested, scaled up to fullStock, never a catalog Product directly (see
// ProductIngredient below for why, and getRestockCandidates in db.js).
model StockItem {
  id                String   @id @default(cuid())
  name              String
  normalizedName    String   @unique
  unit              String?
  stock             Float?
  // Target level a restock aims for -- distinct from lowStockThreshold
  // (the trigger) since "how much is low" and "how much is enough" are
  // different questions an admin sets independently.
  fullStock         Float?
  lowStockThreshold Float?
  unitCost          Float?
  createdAt         DateTime @default(now())

  recipeLinks       ProductIngredient[]
  shoppingListLinks ShoppingListItemStockItem[]

  @@index([normalizedName])
}

// The recipe: how much of a StockItem one unit of a Product consumes (e.g.
// "Sandwich Jambon-Beurre" needs 2 of "Jambon" + 1 of "Pain"). This is the
// quantified link that was missing everywhere else in this app (shopping-
// list <-> product links are informational only, precisely because THIS is
// what they lack) -- with it, a product's costPrice can be derived from its
// ingredients' unitCost instead of guessed/typed by hand, and stats/margins
// finally reflect a real, defensible cost. See recomputeProductCost in
// db.js, run whenever a recipe or an ingredient's unitCost changes.
model ProductIngredient {
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  quantity    Float

  @@id([productId, stockItemId])
}

// A shopping list line destined for a raw StockItem, not a catalog Product
// -- this is the one that actually feeds closeShoppingTrip's restock
// (ShoppingListItemProduct never did for finished goods, since buying a
// "Sandwich Jambon-Beurre" makes no sense; buying "Jambon" does).
model ShoppingListItemStockItem {
  shoppingListItemId String
  shoppingListItem   ShoppingListItem @relation(fields: [shoppingListItemId], references: [id], onDelete: Cascade)
  stockItemId        String
  stockItem          StockItem        @relation(fields: [stockItemId], references: [id], onDelete: Cascade)

  @@id([shoppingListItemId, stockItemId])
}

model Product {
  id              String         @id @default(cuid())
  storefrontId    String
  storefront      Storefront     @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  name            String
  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])
  price           Float
  extraMenuPrice  Float          @default(0)
  costPrice       Float?
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  description     String?        @db.Text
  badge           String         @default("")
  available       Boolean        @default(true)
  icon            String         @default("🥪")
  createdAt       DateTime       @default(now())

  menuGroups        MenuGroupProduct[]
  shoppingListLinks ShoppingListItemProduct[]
  ingredients       ProductIngredient[]

  @@index([categoryId])
  @@index([storefrontId])
  @@index([inventoryItemId])
}

model Menu {
  id           String     @id @default(cuid())
  storefrontId String
  storefront   Storefront @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  name         String
  price        Float
  description  String?    @db.Text
  badge        String     @default("")
  available    Boolean    @default(true)
  icon         String     @default("🍱")
  createdAt    DateTime   @default(now())
  groups       MenuGroup[]

  shoppingListLinks ShoppingListItemMenu[]

  @@index([storefrontId])
}

// A meal-deal choice group (e.g. "Main", "Drink").
model MenuGroup {
  id       String  @id @default(cuid())
  menuId   String
  menu     Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name     String
  position Int     @default(0)

  products MenuGroupProduct[]

  @@index([menuId])
}

// Products offered in a choice group (many-to-many Menu group <-> Product).
model MenuGroupProduct {
  menuGroupId String
  menuGroup   MenuGroup @relation(fields: [menuGroupId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([menuGroupId, productId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model Order {
  id              String     @id @default(cuid())
  storefrontId    String
  storefront      Storefront @relation(fields: [storefrontId], references: [id])
  orderNumber     String     @unique
  status          String     @default("pending") // pending | preparing | ready | completed | cancelled
  isPaid          Boolean    @default(false)
  isFree          Boolean    @default(false)
  userId          String
  userLogin       String
  userDisplayName String
  pickupTime      String
  note            String     @default("") @db.Text
  totalPrice      Float
  createdAt       DateTime   @default(now())

  reviewRating    Int?
  reviewComment   String?    @db.Text
  reviewCreatedAt DateTime?

  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([storefrontId])
}

// An order line. Name/price/cost are duplicated here at order time
// (snapshot), deliberately: history must stay accurate even if the
// original product or meal deal is later changed or deleted.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String  // 'product' | 'menu'
  refId     String  // id of the product/meal deal at order time
  name      String
  category  String? // snapshot, used only for the displayed icon
  price     Float
  costPrice Float?
  quantity  Int

  choices OrderItemChoice[]

  @@index([orderId])
}

// For a "meal deal" line: which product was chosen in each group.
// Also a snapshot (name + cost at order time).
model OrderItemChoice {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  groupName   String
  productId   String
  productName String
  costPrice   Float?

  @@index([orderItemId])
}
