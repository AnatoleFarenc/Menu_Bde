# BDE 42 Sandwich Shop Server Configuration
NODE_ENV=production
PORT=5001

# Single, STABLE public URL the site is reachable at.
# This is the ONLY URL to set: the OAuth Redirect URI is derived from it
# automatically (<PUBLIC_APP_URL>/api/auth/42/callback).
# Examples:
#   http://localhost:5001                 (local testing only)
#   http://192.168.1.42:5001              (another PC on the local network)
#   https://bde-42.ngrok-free.app         (static ngrok domain)
#   https://mon-pc.mon-tailnet.ts.net     (Tailscale Funnel)
PUBLIC_APP_URL=http://localhost:5001

# 42 Intra OAuth2 API (create your application at https://profile.intra.42.fr/oauth/applications)
INTRA42_CLIENT_ID=your_42_intra_uid
INTRA42_CLIENT_SECRET=your_42_intra_secret

# Optional: only set this variable to force a Redirect URI different from
# <PUBLIC_APP_URL>/api/auth/42/callback.
# INTRA42_REDIRECT_URI=

# 42 logins allowed as BDE Administrators -- live order tracking board
# (comma-separated)
ADMIN_LOGINS=42_login, other_42_login

# 42 logins allowed into the /gestion tool -- event/catalog/stock management.
# Independent from ADMIN_LOGINS: a login can be in either list, both, or
# neither. If unset, defaults to ADMIN_LOGINS (single-tier access).
MANAGER_LOGINS=42_login, other_42_login

# Kiosk terminal activation code: NOTHING to configure. The server generates
# one automatically on first use and keeps it in the database; a Board
# member reads and regenerates it anytime from Gestion > Équipe. Only set
# this variable to force a specific value instead (e.g. to share one across
# several servers) -- while set, it can't be regenerated from Gestion.
# KIOSK_SECRET=

# MariaDB database.
# Locally: run `docker compose up -d` (see docker-compose.yml), then keep the
# default credentials below (local dev only).
DATABASE_URL="mysql://bde_app:devpassword@localhost:3306/bde_sandwich"

# Web Push (new-order alerts on the staff's phones/computers, even with the site
# closed): NOTHING to configure. The server generates its key pair on first start
# and keeps it in the database. Only set these to force a specific pair (e.g. to
# share one between two servers) -- and never change them afterwards, or every
# device that enabled notifications has to enable them again.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Optional contact sent to the push services (mailto:you@example.com); defaults
# to PUBLIC_APP_URL when that is https.
# VAPID_SUBJECT=
