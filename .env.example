# Configuration Serveur BDE 42 Sandwicherie
NODE_ENV=production
PORT=5001

# URL publique unique et STABLE par laquelle le site est joignable.
# C'est la SEULE URL à renseigner : la Redirect URI OAuth en est déduite
# automatiquement (<PUBLIC_APP_URL>/api/auth/42/callback).
# Exemples :
#   http://localhost:5001                 (test local uniquement)
#   http://192.168.1.42:5001              (autre PC du réseau local)
#   https://bde-42.ngrok-free.app         (domaine statique ngrok)
#   https://mon-pc.mon-tailnet.ts.net     (Tailscale Funnel)
PUBLIC_APP_URL=http://localhost:5001

# API OAuth2 Intra 42 (Créez votre application sur https://profile.intra.42.fr/oauth/applications)
INTRA42_CLIENT_ID=votre_uid_intra_42
INTRA42_CLIENT_SECRET=votre_secret_intra_42

# Optionnel : ne renseignez cette variable que pour forcer une Redirect URI
# différente de <PUBLIC_APP_URL>/api/auth/42/callback.
# INTRA42_REDIRECT_URI=

# Logins 42 autorisés en tant qu'Administrateurs BDE (séparés par des virgules)
ADMIN_LOGINS=42_login, other_42_login
